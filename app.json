{
  "expo": {
    "name": "Sapphire",
    "slug": "obsidian-expo",
    "owner": "ramimaalouf",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/brand/sapphire.png",
    "scheme": "obsidianexpo",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "supportsTablet": true,
      "deploymentTarget": "27.0",
      "bundleIdentifier": "com.ramimaalouf.obsidianexpo",
      "icon": "./assets/brand/sapphire.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ramimaalouf.obsidianexpo",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D0D",
        "foregroundImage": "./assets/brand/sapphire.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/sapphire.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D0D",
          "image": "./assets/brand/sapphire.png",
          "imageWidth": 110,
          "dark": {
            "backgroundColor": "#0B0D0D",
            "image": "./assets/brand/sapphire.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "34b038c2-b880-4e9a-b790-38a7441e6486"
      }
    }
  }
}
