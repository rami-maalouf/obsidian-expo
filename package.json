{
  "name": "obsidian-expo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@expo/ui": "~58.0.15",
    "expo": "~58.0.7",
    "expo-constants": "~58.0.10",
    "expo-dev-client": "~58.0.12",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.7",
    "expo-glass-effect": "~58.0.3",
    "expo-image": "~58.0.13",
    "expo-linking": "~58.0.11",
    "expo-router": "~58.0.17",
    "expo-splash-screen": "~58.0.7",
    "expo-sqlite": "~58.0.11",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.5",
    "expo-updates": "~58.0.15",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.4",
    "react-native-drawer-layout": "4.2.11",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "1.3.14",
    "@types/react": "~19.3.0",
    "eslint": "^9",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "bun test",
    "check:references": "bun scripts/check-references.mjs",
    "check": "bun run check:references && bun run typecheck && bun run lint && bun run test",
    "export": "expo export --platform all",
    "icons": "bun scripts/generate-icons.ts",
    "icons:android": "bun scripts/generate-android-icons.ts",
    "dev": "APP_VARIANT=development expo start",
    "build:dev": "bunx eas-cli@latest build --profile development --platform ios",
    "build:preview": "bunx eas-cli@latest build --profile preview --platform ios",
    "build:dev:android": "bunx eas-cli@latest build --profile development --platform android",
    "build:preview:android": "bunx eas-cli@latest build --profile preview --platform android",
    "update:preview": "APP_VARIANT=preview bunx eas-cli@latest update --channel preview --environment preview"
  },
  "private": true
}
